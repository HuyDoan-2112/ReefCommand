# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
# Used only by the Coordinator and the three LLM-backed evidence investigators.
REEFCOMMAND_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
REEFCOMMAND_LLM_MODEL=claude-sonnet-5
REEFCOMMAND_LLM_TIMEOUT_SECONDS=30
REEFCOMMAND_LLM_MAX_TOKENS=4096
REEFCOMMAND_LLM_RETRY_BACKOFF_SECONDS=0.5
# For DeepSeek testing, set the provider to deepseek, use a DeepSeek model, and
# provide the key. DeepSeek uses an OpenAI-compatible strict function call.
REEFCOMMAND_DEEPSEEK_API_KEY=
REEFCOMMAND_DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
# Leave false when a stale local HTTP(S) proxy blocks direct DeepSeek access.
REEFCOMMAND_DEEPSEEK_TRUST_ENV=false

# --- Runtime ---
REEFCOMMAND_ENV=development
REEFCOMMAND_LOG_LEVEL=INFO
REEFCOMMAND_API_HOST=127.0.0.1
REEFCOMMAND_API_PORT=8000

# --- External data ---
# Live calls are wrapped with a short timeout and fall back to the cached copy.
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
REEFCOMMAND_EXTERNAL_TIMEOUT_SECONDS=3
# When true, no live external call is attempted at all. Use this for demos.
REEFCOMMAND_FORCE_CACHE=false
# Keep true for the deterministic fixture-backed demo. Set false only when an
# Anthropic key and permitted external evidence sources are configured.
REEFCOMMAND_OFFLINE_DEMO=true

# --- Frontend ---
# Next.js rewrites /api/* to this. Set it on Vercel to the deployed backend URL.
REEFCOMMAND_API_URL=http://127.0.0.1:8000
